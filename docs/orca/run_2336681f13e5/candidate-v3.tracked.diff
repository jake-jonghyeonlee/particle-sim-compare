+    for _ in range(100):
+        x0, x1 = sorted(rng.uniform(-pixel_um, 25 * pixel_um, 2))
+        y0, y1 = sorted(rng.uniform(-pixel_um, 19 * pixel_um, 2))
+        bounds.append([x0, y0, x1, y1])
+    # 닫힌 경계가 픽셀 중심에 정확히 겹쳐도 기존 포함 판정과 같아야 한다.
+    for y, x in ((0, 0), (8, 11), (16, 22)):
