+            else:
+                self._unlink(final)
+        self._unlink(self._marker().with_name(self._marker().name + '.partial'))
+        self._discard_material()
+
+    @staticmethod
+    def _finish(handle):
+        handle.flush()
+        os.fsync(handle.fileno())
+        handle.close()
+
+    def abort(self):
+        if self._fh is not None:
+            try:
+                self._fh.close()
+            except (OSError, ValueError):
+                pass
+            self._fh = None
+        for path in self._temps:
+            try:
+                path.unlink()
+            except OSError:
+                pass
+        self._temps = []
+
