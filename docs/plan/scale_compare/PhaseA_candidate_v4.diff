+    def _sync_dir(self):
+        try:
+            dir_fd = os.open(str(self.output), os.O_RDONLY)
+        except OSError:
+            return
+        try:
+            os.fsync(dir_fd)
+        except OSError:
+            pass
+        finally:
+            os.close(dir_fd)
