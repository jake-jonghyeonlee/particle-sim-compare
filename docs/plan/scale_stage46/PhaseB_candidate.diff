+def _clone_numeric(tmp_path, name='root'):
+    root = tmp_path/name
+    shutil.copytree(NUMERIC, root)
+    reference = {'path': 'review_assets.json', 'sha256': hashlib.sha256((root/'review_assets.json').read_bytes()).hexdigest()}
+    return root, reference
